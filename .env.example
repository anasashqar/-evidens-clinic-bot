# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI - Groq
GROQ_API_KEY=your_groq_api_key

# WhatsApp - Z-API
Z_API_INSTANCE=your_instance_id
Z_API_TOKEN=your_token
Z_API_CLIENT_TOKEN=your_client_token
Z_API_BASE_URL=https://api.z-api.io

# Webhook Security — أضفه كـ query param في رابط Z-API webhook
# مثال: https://yoursite.com/trpc/webhook.zapi?secret=YOUR_SECRET_HERE
# أنشئ قيمة عشوائية آمنة: openssl rand -hex 32
WEBHOOK_SECRET=

# CRM - GoHighLevel
GHL_API_KEY=your_ghl_api_key
GHL_LOCATION_ID=your_location_id
GHL_CALENDAR_ID=your_calendar_id

# Notifications
ELIANA_PHONE_NUMBER=5511973015859 # Number to receive handoff notifications

# Testing
ALLOWED_PHONE_NUMBERS=number1,number2 # Comma separated list of numbers allowed to use the bot in dev
